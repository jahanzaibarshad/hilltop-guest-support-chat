{
  "name": "hilltop-guest-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test --workspace client && npm run test:coverage --workspace server",
    "test:performance": "node server/scripts/performance.js",
    "test:atlas": "node server/scripts/check-atlas.js",
    "security:check": "node scripts/audit-dependencies.js",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
